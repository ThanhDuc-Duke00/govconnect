# Biến môi trường cho docker-compose.prod.yml.
#
# Copy file này thành `.env` NGAY CẠNH docker-compose.prod.yml trên server rồi điền
# giá trị thật. `.env` đã nằm trong .gitignore — không bao giờ commit giá trị thật.
#
#   cp .env.example .env && nano .env
#   docker compose -f docker-compose.prod.yml up -d --build

# ─── Zalo Mini App ───────────────────────────────────────────────────────────
# Lấy ở Zalo for Developers → ứng dụng tương ứng → phần thông tin ứng dụng.
# App ID phải TRÙNG với "appId" trong miniapp/app-config.json, và trùng với
# tenant_zalo_configs.zalo_app_id của phường trong CSDL — lệch một trong hai thì
# đăng nhập trả 403 "App ID không khớp với phường/xã.".
#
# Để trống ZALO_APP_SECRET thì backend TỪ CHỐI mọi lượt đăng nhập Zalo (fail closed).
ZALO_APP_ID=4023889144671265930
ZALO_APP_SECRET=

# API Key cua Mini App — KHAC AppSecret o tren.
# Lay o mini.zalo.me/developers -> Mini App -> Open APIs -> Quan ly APIs: dien IP Access
# + Webhook URL + Scopes roi bam "Cap nhat", he thong MOI sinh API Key ra cho ban.
# Dung de verify chu ky x-zevent-signature cua webhook (POST /api/zalo/webhook).
# De trong thi webhook tra 401 cho MOI request — ke ca request that cua Zalo (fail closed).
ZALO_WEBHOOK_API_KEY=

# ─── Bảo mật ─────────────────────────────────────────────────────────────────
# Sinh bằng:  openssl rand -base64 48
# Không còn giá trị mặc định: bỏ trống thì backend không ký được token nào.
# Đổi khoá này sẽ vô hiệu mọi phiên đăng nhập đang mở.
JWT_SIGNING_KEY=

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
