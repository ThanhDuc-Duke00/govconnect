{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp"
      ]
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "govconnect-db": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@executeautomation/database-server",
        "--postgresql",
        "--host",
        "localhost",
        "--port",
        "5432",
        "--database",
        "govconnect",
        "--user",
        "govconnect",
        "--password",
        "govconnect"
      ],
      "env": {}
    }
  }
}
